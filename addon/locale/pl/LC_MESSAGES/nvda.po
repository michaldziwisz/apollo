#. Manual: voices 1-3 are male-based, 4-6 are non-male-based.
#.
#. In "auto" voice filter mode, we map each voice to a distinct voice source/filter (`@$o`)
#. so the Voice selection yields clearly different timbres on ROMs where @V voices are similar.
#: addon/synthDrivers/apollo2/driver.py:1887
msgid "Voice 1 (male default)"
msgstr "Głos 1 (męski, domyślny)"

#: addon/synthDrivers/apollo2/driver.py:1888
msgid "Voice 2 (male spike)"
msgstr "Głos 2 (męski, spike)"

#: addon/synthDrivers/apollo2/driver.py:1889
msgid "Voice 3 (male reduced high-frequency filter)"
msgstr "Głos 3 (męski, filtr z ograniczonymi wysokimi częstotliwościami)"

#: addon/synthDrivers/apollo2/driver.py:1890
msgid "Voice 4 (female default)"
msgstr "Głos 4 (żeński, domyślny)"

#: addon/synthDrivers/apollo2/driver.py:1891
msgid "Voice 5 (female spike)"
msgstr "Głos 5 (żeński, spike)"

#: addon/synthDrivers/apollo2/driver.py:1892
msgid "Voice 6 (female reduced high-frequency filter)"
msgstr "Głos 6 (żeński, filtr z ograniczonymi wysokimi częstotliwościami)"

